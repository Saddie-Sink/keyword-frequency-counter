# Kafka Configuration (Member 2)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=text_stream
KAFKA_CONSUMER_GROUP=spark_keyword_analytics_group

# PostgreSQL Configuration (Member 4)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=keyword_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Producer Defaults (Member 1)
DEFAULT_STREAM_RATE=10
DEFAULT_STREAM_CATEGORY=Technology

# Spark Configuration (Member 3)
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_DIR=./data/spark_checkpoints
